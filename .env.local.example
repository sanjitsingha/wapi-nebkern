# ============================================================
# REQUIRED — the app won't start without these.
# ============================================================

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service-role key. Bypasses RLS; used only by server-side
# routes (the webhook and automation engine). Keep this secret —
# never paste it into client code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# WhatsApp token encryption (64 hex chars = 32 bytes, AES-256-GCM).
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this value orphans every token encrypted under the previous
# key — users have to re-save their WhatsApp settings to reconnect.
ENCRYPTION_KEY=your-64-char-hex-key-here

# Meta App Secret (Meta for Developers → App Settings → Basic).
# Verifies the HMAC-SHA256 signature on every inbound webhook POST.
# Required — without it the webhook rejects every request.
META_APP_SECRET=your-meta-app-secret

# ============================================================
# RECOMMENDED — safe defaults exist but you'll want to set these.
# ============================================================

# Canonical public URL of this deployment (scheme + host, no trailing
# slash). Used for the sitemap and OG images. Routes that need a
# self-referential URL (invite links from /api/account/invitations,
# any future email-bound link) derive the origin from the request
# itself, so this variable is *only* needed when the request-derived
# origin would be wrong — e.g. when generating links from a cron job
# or a background worker that has no incoming request.
NEXT_PUBLIC_SITE_URL=https://crm.example.com

# ============================================================
# OPTIONAL — only needed if you use the feature.
# ============================================================

# ------------------------------------------------------------
# Cloudflare R2 — object storage for uploads (chat attachments,
# flow media, template media, avatars).
#
# WHY: Supabase's free tier meters egress at 5 GB/month, and every image
# view came out of it. R2 charges NOTHING for egress, ever — so moving
# uploads there takes image traffic off the metered budget entirely
# rather than merely reducing it. Its free tier is 10 GB of storage,
# 1M uploads and 10M downloads per month.
#
# ENTIRELY OPTIONAL. When any of these is unset the app falls back to
# Supabase Storage and behaves exactly as it always has — nothing
# breaks, you just keep paying egress. Files uploaded before you switch
# R2 on keep working from their existing Supabase URLs.
#
# Setup (Cloudflare dashboard → R2):
#   1. Create a bucket.
#   2. Manage R2 API Tokens → create a token with "Object Read & Write"
#      scoped to that bucket only. Copy the Access Key ID and Secret.
#   3. Bucket → Settings → Public access → connect a Custom Domain,
#      e.g. media.your-domain.com.
#
# The custom domain is effectively required, for two reasons: Cloudflare
# rate-limits the free r2.dev address and advises against it in
# production, and META FETCHES THESE URLS DIRECTLY when you send media
# on WhatsApp — if Meta can't reach the file, the send fails.
#
#   R2_ACCOUNT_ID        — Cloudflare account id (R2 overview page).
#   R2_ACCESS_KEY_ID     — from the API token above.
#   R2_SECRET_ACCESS_KEY — from the API token above. Server-side only,
#                          never exposed to the browser: these creds can
#                          read and delete the whole bucket, and R2 has
#                          no equivalent of Supabase's row-level
#                          security. The browser gets short-lived
#                          presigned links from /api/storage/upload-url
#                          instead.
#   R2_BUCKET            — the bucket name.
#   R2_PUBLIC_BASE_URL   — public origin objects are served from, no
#                          trailing slash (https://media.your-domain.com).
#
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# R2_BUCKET=wacrm-media
# R2_PUBLIC_BASE_URL=https://media.your-domain.com

# Admin panel (src/app/admin) — comma-separated list of operator emails
# allowed into /admin. An admin signs in at /admin/login with their normal
# Supabase account; only emails on this list are granted back-office access
# (cross-tenant, via the service-role key). Unset/empty ⇒ nobody is an admin,
# and /admin/login rejects every sign-in. This is the whole access gate, so
# keep the list tight.
#   ADMIN_EMAILS=you@example.com,ops@example.com

# Defense-in-depth allow-list for the hostnames that
# /api/account/invitations is willing to publish in invite URLs.
# Comma-separated, no scheme, no port (just hostnames).
#
# Why this exists: when NEXT_PUBLIC_SITE_URL is unset, invite URLs
# are derived from the incoming request's `Host` / `X-Forwarded-
# Host` header. On a typical proxied deploy the proxy sets these
# to your canonical hostname and they're trustworthy. On a *bare*
# deployment exposed to the public internet, an attacker could
# POST to the API directly with a spoofed `Host: phishing.example`
# and receive an invite URL pointing at their site.
#
# When this var is set, hostnames not on the list are rejected
# (the request falls through to the wacrm.tech fallback with a
# console.warn). When unset, behavior is unchanged from earlier
# versions — the request-derived host is trusted.
#
# Most operators don't need this: setting NEXT_PUBLIC_SITE_URL to
# your canonical URL already pins invite links there. This is for
# operators who want belt-and-braces or run multi-tenant setups
# where one app instance serves several hostnames.
#
# Example:
#   ALLOWED_INVITE_HOSTS=crm.example.com,crm-staging.example.com

# Shared secret protecting GET /api/automations/cron. Required if you
# use Wait steps in automations (a scheduled pinger drains pending
# executions). Generate any long random string:
#   openssl rand -hex 32
# See docs/automations-and-cron.md.
# AUTOMATION_CRON_SECRET=generate-a-long-random-string

# Meta App ID (Meta for Developers → App Settings → Basic). Required to
# create/edit message templates with an IMAGE header: Meta only accepts a
# Resumable-Upload media handle (not a plain URL) as the header sample, and
# that upload is app-scoped. Without it, image-header template submission
# returns a clear error; text/body-only templates are unaffected. Pair
# with META_APP_SECRET.
#
# ALSO required (server-side) for Meta Embedded Signup: the onboarding
# route exchanges the authorization code via
# GET /oauth/access_token?client_id=META_APP_ID&client_secret=META_APP_SECRET.
# Without both, POST /api/whatsapp/embedded-signup returns a 503 with a
# clear "Embedded Signup is not configured" message.
# META_APP_ID=your-meta-app-id

# ------------------------------------------------------------
# Meta Embedded Signup (one-click WhatsApp onboarding).
#
# These two are PUBLIC (NEXT_PUBLIC_*) because the Facebook JS SDK runs
# in the browser. They are safe to expose — the secret half of the
# exchange is META_APP_SECRET above, which stays server-side.
#
#   NEXT_PUBLIC_META_APP_ID       — same value as META_APP_ID.
#   NEXT_PUBLIC_META_ES_CONFIG_ID — the Embedded Signup *configuration*
#                                   id from Meta for Developers →
#                                   your App → WhatsApp → Embedded Signup
#                                   → Configurations. Requires your app
#                                   to be set up as a Tech Provider /
#                                   Solution Partner.
#




# When either is unset, the "Quick connect" button is hidden and the UI
# falls back to manual credential entry — nothing breaks.
# NEXT_PUBLIC_META_APP_ID=your-meta-app-id
# NEXT_PUBLIC_META_ES_CONFIG_ID=your-embedded-signup-configuration-id

# When "true", POST /api/whatsapp/templates/submit skips the Meta call
# and stores the row with a synthetic `dry-run-<uuid>` meta_template_id.
# Set this in CI and local development so you can exercise the full
# template UI without a real WABA. Leave unset (or "false") in prod.
# WHATSAPP_TEMPLATES_DRY_RUN=true

# ------------------------------------------------------------
# Instagram + Messenger — the unified connect (Settings → Instagram &
# Messenger).
#
# One Facebook Login for Business consent returns the Page (Messenger)
# and the Instagram professional account linked to it, sharing one Page
# access token. It reuses META_APP_ID / META_APP_SECRET above — no extra
# credentials — and needs this exact redirect URI whitelisted at Meta for
# Developers → your App → Facebook Login → Settings:
#   {your-app-origin}/api/meta/oauth/callback
#
# The Meta app also needs the Messenger and Instagram products added, and
# the callback URLs registered under Webhooks (the settings panel shows
# both URLs and their verify tokens).
#
# META_LOGIN_CONFIG_ID is OPTIONAL. Set it when your Meta app uses a
# Facebook Login for Business *configuration* (Meta for Developers → your
# App → Facebook Login for Business → Configurations) instead of a raw
# scope list — apps created after Meta's 2024 change usually do. When
# set, the consent screen is driven by that configuration; when unset, we
# request the scopes directly. Either way the button works.
# META_LOGIN_CONFIG_ID=your-facebook-login-for-business-configuration-id

# ------------------------------------------------------------
# Instagram Business Login (legacy per-channel "Connect with Instagram").
#
# Superseded by the unified connect above, which is what Settings now
# surfaces — this one is kept only for the manual/standalone path under
# /api/instagram/*. No Facebook Page involved. Create it at Meta for
# Developers → your App → Instagram → Business Login, and add this exact
# redirect URI there:
#   {your-app-origin}/api/instagram/oauth/callback
#
# NOTE: accounts connected this way hold a graph.instagram.com token,
# which the send path (graph.facebook.com/{ig-id}/messages) does not
# accept — reconnect through the unified flow to get a working Page
# token.
#
#   INSTAGRAM_APP_ID              — server-side, used in the token
#                                    exchange. Also exposed to the
#                                    browser as NEXT_PUBLIC_INSTAGRAM_APP_ID
#                                    below (same value) since the
#                                    "Connect" button needs it to check
#                                    whether one-click login is enabled.
#   INSTAGRAM_APP_SECRET          — server-side only, never exposed.
#   NEXT_PUBLIC_INSTAGRAM_APP_ID  — same value as INSTAGRAM_APP_ID.
#
# When unset, the "Connect with Instagram" button shows a setup hint
# instead and the settings page falls back to manual credential entry
# (Page ID + IG Business Account ID + Page Access Token) — nothing
# breaks.
# INSTAGRAM_APP_ID=your-instagram-app-id
# INSTAGRAM_APP_SECRET=your-instagram-app-secret
# NEXT_PUBLIC_INSTAGRAM_APP_ID=your-instagram-app-id

# ---- Google sign-in without the supabase.co redirect (optional) ----
# By default "Continue with Google" uses supabase.auth.signInWithOAuth,
# which routes through <project-ref>.supabase.co — so Google's consent
# card reads "to continue to <project-ref>.supabase.co". That string is
# the redirect URI's host and cannot be rebranded: Google only prints a
# name for a domain you can verify in Search Console, and supabase.co
# isn't yours.
#
# Setting both of these switches the login/signup buttons to Google
# Identity Services, which returns an ID token straight to the page (no
# redirect), so Google names YOUR origin instead.
#
# Before enabling, in Google Cloud Console → Credentials → your OAuth
# client, add to "Authorized JavaScript origins":
#   http://localhost:3000  and  https://your-domain.com
# and in Supabase → Auth → Providers → Google, put the same client id in
# "Authorized Client IDs" or the token's audience won't validate.
#
# Does NOT affect Settings → Security → Link Google: supabase-js has no
# ID-token equivalent of linkIdentity, so that flow keeps redirecting.
# NEXT_PUBLIC_GOOGLE_GIS=1
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
